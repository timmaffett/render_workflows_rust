  "description": "Unofficial: write Render Workflows tasks in Rust, compiled to a native Node addon. Not affiliated with or endorsed by Render.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmaffett/render_workflows_rust.git"
  },
  "keywords": [
    "render",
    "workflows",
    "rust",
    "napi",
    "node-api"
  ],
  "bin": {
